# Merged onto x86_64_defconfig by ci/build.sh. Every symbol here must end up
# with exactly this value, or the build fails (Kconfig drops symbols whose
# dependencies are unmet, silently).
CONFIG_RUST=y
CONFIG_WERROR=y
CONFIG_MODULES=y
CONFIG_SAMPLES=y
CONFIG_SAMPLES_RUST=y
CONFIG_SAMPLE_RUST_MINIMAL=m
CONFIG_SAMPLE_RUST_PRINT=m
CONFIG_HW_RANDOM=y
CONFIG_SAMPLE_RUST_HWRNG=m
# Boot test (ci/boot.sh): QEMU q35, virtio disk, serial console, initramfs.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
