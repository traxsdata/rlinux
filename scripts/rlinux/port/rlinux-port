def cmd_analyze(args) -> int:
    d = parse(args.file)
    k = kconfig_facts(d)
    ok, gaps, cautions = coverage(d)
    print(f"file:        {d.path}  ({d.raw.count(chr(10))} lines)")
    print(f"bus:         {d.bus}")
    print(f"module:      {d.module}   driver name: {d.name or '-'}")
    print(f"license:     {d.license}   SPDX: {d.spdx}")
    print(f"kconfig:     CONFIG_{k['symbol']}  depends on: {'; '.join(k['depends']) or '-'}")
    print(f"makefile:    {k['makefile_line'] or '-'}")
    if d.of_ids:
        print("of ids:      " + ", ".join(f"{c}{' (data ' + x + ')' if x else ''}" for c, x in d.of_ids))
    if d.acpi_ids:
        print("acpi ids:    " + ", ".join(d.acpi_ids))
    if d.hwrng:
        print("hwrng:       " + ", ".join(f"{k2}={v}" for k2, v in d.hwrng.items())
              + ("   (name from pdev/dev: use HwRngName::Owned(dev.name().to_cstring()?))" if d.hwrng_name_from_pdev else ""))
    for drv in d.phy_drivers:
        print("phy driver:  " + ", ".join(f"{k2}={v}" for k2, v in drv.items()))
    print(f"defines:     {len(d.defines)} (become `const`s)")
    print(f"functions:   {', '.join(d.functions) or '-'}")
    print("\nsupported:")
    for line in ok:
        print(f"  + {line}")
    if cautions:
        print("cautions:")
        for line in cautions:
            print(f"  ! {line}")
    unk = unknown_calls(d)
    if unk:
        print("unrecognised calls (check by hand: is there a Rust equivalent?):")
        print("  ? " + ", ".join(unk))
    print("gaps:" if gaps else "gaps: none")
    for line in gaps:
        print(f"  - {line}")
    verdict = ("portable (check the unrecognised calls)" if unk else "portable") \
        if not gaps and d.bus in ("platform", "phy") else \
              ("needs abstraction" if gaps else f"no template for bus '{d.bus}'")
    print(f"\nverdict:     {verdict}")
    return 0 if verdict.startswith("portable") else 1


