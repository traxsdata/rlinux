def sibling_text(d: Driver, name: str) -> str | None:
    """Text of a file next to the driver, from the same revision as the driver."""
    rel = str(Path(d.path).parent / name)
    if d.rev:
        r = subprocess.run(["git", "show", f"{d.rev}:{rel}"], capture_output=True, text=True)
        return r.stdout if r.returncode == 0 else None
    f = TREE / rel
    return f.read_text() if f.exists() else None


def kconfig_facts(d: Driver) -> dict:
    p = TREE / d.path
    facts = {"symbol": None, "makefile_line": None, "kconfig": None, "depends": [], "kblock": ""}
    mk_text = sibling_text(d, "Makefile")
    if mk_text is None:
        return facts
    for line in mk_text.splitlines():
        m = re.match(rf"\s*obj-\$\(CONFIG_(\w+)\)\s*\+=.*\b{re.escape(p.stem)}\.o\b", line)
        if m:
            facts["symbol"], facts["makefile_line"] = m.group(1), line.strip()
            break
    kc = p.parent / "Kconfig"
    text = sibling_text(d, "Kconfig")
    if facts["symbol"] and text is not None:
        m = re.search(rf"^config {facts['symbol']}\n((?:[ \t].*\n|\n)*?)(?=^\S|\Z)", text, re.M)
        if m:
            facts["kconfig"] = str(kc.relative_to(TREE))
            facts["kblock"] = m.group(0)
            facts["depends"] = [l.strip()[len("depends on "):] for l in m.group(1).splitlines()
                                if l.strip().startswith("depends on ")]
    return facts


