def split_args(argtext: str) -> list[str]:
    """Split a call's argument text on top-level commas."""
    out, depth, cur = [], 0, []
    for i, ch in enumerate(argtext):
        if ch in "([{<":
            depth += 1
        # `>` closes a Rust generic, but `->` (C pointer dereference, Rust
        # fat arrow) is not a bracket.
        elif ch in ")]}>" and not (ch == ">" and i > 0 and argtext[i - 1] == "-"):
            depth -= 1
        if ch == "," and depth == 0:
            out.append("".join(cur).strip()); cur = []
        else:
            cur.append(ch)
    if "".join(cur).strip():
        out.append("".join(cur).strip())
    return out


def reg_of(expr: str) -> str:
    """Name of the register in an address/offset expression (`base + REG`, `C22::BMCR`, `REG`)."""
    expr = re.sub(r"\bMII_", "", expr)
    expr = re.sub(r"C22::new\((.*)\)|C22::vendor_specific::<(.*?)>\(\)", lambda m: m.group(1) or m.group(2), expr)
    expr = re.sub(r"C22::", "", expr)
    caps = re.findall(r"\b([A-Z][A-Z0-9_]{1,})\b", expr)
    if caps:
        return caps[-1]
    ids = re.findall(r"\b([a-z_]\w*)\b", expr)
    return ids[-1] if ids else "?"


# (C name, kind, index of the offset argument: -1 = last)
# The `*_poll_timeout` variants take the address as their first argument.
C_OPS = {"readl": ("R32", -1), "readw": ("R16", -1), "readb": ("R8", -1), "ioread32": ("R32", -1),
         "readl_poll_timeout": ("R32", 0), "readl_poll_timeout_atomic": ("R32", 0),
         "readl_relaxed_poll_timeout": ("R32", 0), "readl_relaxed_poll_timeout_atomic": ("R32", 0),
         "writel_poll_timeout": ("W32", 0), "writel_poll_timeout_atomic": ("W32", 0),
         "writel_relaxed_poll_timeout": ("W32", 0), "writel_relaxed_poll_timeout_atomic": ("W32", 0),
         "writel": ("W32", -1), "writew": ("W16", -1), "writeb": ("W8", -1), "iowrite32": ("W32", -1),
         "phy_read": ("PHY.R", 1), "phy_write": ("PHY.W", 1), "phy_read_mmd": ("PHY.R45", 2),
         "phy_write_mmd": ("PHY.W45", 2), "mdiobus_c45_read": ("C45.R", -1), "mdiobus_c45_write": ("C45.W", 3)}
RS_OPS = {"read32": ("R32", 0), "read16": ("R16", 0), "read8": ("R8", 0),
          "write32": ("W32", -1), "write16": ("W16", -1), "write8": ("W8", -1),
          "read": ("PHY.R", 0), "write": ("PHY.W", 0), "c45_read_raw": ("C45.R", -1)}


def accesses(text: str, is_rust: bool, aliases: dict[str, str] | None = None) -> list[str]:
    seq = []
    if is_rust:
        pat = re.compile(r"\.(?:try_)?(read32|read16|read8|write32|write16|write8|read|write|c45_read_raw)(?:_relaxed)?\s*\(")
        table = RS_OPS
    else:
        pat = re.compile(
            r"\b(readl_poll_timeout|readl_poll_timeout_atomic|readl_relaxed_poll_timeout"
            r"|readl_relaxed_poll_timeout_atomic|readl|readw|readb|ioread32"
            r"|writel_poll_timeout|writel_poll_timeout_atomic|writel_relaxed_poll_timeout"
            r"|writel_relaxed_poll_timeout_atomic|writel|writew|writeb|iowrite32"
            r"|phy_read_mmd|phy_write_mmd|phy_read|phy_write|mdiobus_c45_read|mdiobus_c45_write)(?:_relaxed)?\s*\(")
        table = C_OPS
    # Alias address variables (`void __iomem *cfg = base + REG;`,
    # `rng->cfg_addr = base + REG;`): resolve to REG. Callers may pass a
    # file-wide table so assignments outside the current function apply.
    if aliases is None:
        aliases = {} if is_rust else {v: r for v, r in re.findall(
            r"\b(\w+)\s*=\s*[^;=]*?\+\s*([A-Z][A-Z0-9_]+)\s*;", text)}
    for m in pat.finditer(text):
        op = m.group(1)
        open_i = m.end() - 1
        args = split_args(text[open_i + 1:matching(text, open_i, "(", ")") - 1])
        kind, idx = table[op]
        if not args:
            continue
        if is_rust and op in ("read", "write") and not re.search(r"C22|C45|[A-Z_]{3,}", args[0]):
            continue
        if is_rust and op in ("read", "write") and "C45" in args[0]:
            kind = "PHY.R45" if op == "read" else "PHY.W45"
        try:
            reg = reg_of(args[idx])
            seq.append(f"{kind}({aliases.get(reg, reg)})")
        except IndexError:
            seq.append(f"{kind}(?)")
    return seq


def cmd_compare(args) -> int:
    d = parse(args.c)
    _, rs = read_source(args.rust)
    rs_code = re.sub(r"//.*", "", rs)
    status = 0
    c_set, r_set = set(), set()
    # C code often computes an address once (`rng->cfg_addr = base + REG;`)
    # and uses it from several functions, so build the alias table from the
    # whole file, not from each function separately.
    aliases = {v: r for v, r in re.findall(
        r"(?:\w+->\s*)?(\w+)\s*=\s*[^;=]*?\+\s*([A-Z][A-Z0-9_]+)\s*;", d.code)}
    print(f"register accesses ({args.c} vs {args.rust}):")
    for name, body in d.functions.items():
        seq = accesses(body, False, aliases)
        if seq:
            c_set.update(seq)
            print(f"  C  {name}: {' '.join(seq)}")
    for m in re.finditer(r"\bfn\s+(\w+)\s*[<(]", rs_code):
        start = rs_code.find("{", m.end())
        if start < 0:
            continue
        body = rs_code[start:matching(rs_code, start)]
        seq = accesses(body, True)
        if seq:
            r_set.update(seq)
            print(f"  RS {m.group(1)}: {' '.join(seq)}")
    only_c, only_r = sorted(c_set - r_set), sorted(r_set - c_set)
    if only_c:
        status = 1
        print("  in C only:   " + ", ".join(only_c))
    if only_r:
        print("  in Rust only: " + ", ".join(only_r))
    if not only_c and not only_r:
        print("  same set of accesses (check order per function above)")
    c_ids = {c for c, _ in d.of_ids} | set(d.acpi_ids)
    r_ids = set(re.findall(r'(?:of|acpi)::DeviceId::new\(c"([^"]+)"\)', rs))
    if c_ids or r_ids:
        if c_ids != r_ids:
            status = 1
            print(f"OF ids differ: C-only {sorted(c_ids - r_ids)}  Rust-only {sorted(r_ids - c_ids)}")
        else:
            print(f"OF ids: identical ({len(c_ids)})")
    todos = [i + 1 for i, l in enumerate(rs.splitlines()) if "TODO(port)" in l]
    if todos:
        status = 1
        print(f"TODO(port) left on lines: {todos}")
    if re.search(r"\bunsafe\b", rs_code):
        print("note: driver contains `unsafe`; every block needs a `// SAFETY:` comment")
    return status


