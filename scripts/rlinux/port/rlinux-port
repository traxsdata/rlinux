# --------------------------------------------------------------------------
# Reading sources
# --------------------------------------------------------------------------

def read_source(spec: str) -> tuple[str, str]:
    """Return (path, text) for a file path or a `REV:path` git spec."""
    if ":" in spec and not os.path.exists(spec):
        rev, path = spec.split(":", 1)
        text = subprocess.run(["git", "show", f"{rev}:{path}"], capture_output=True,
                              text=True, check=True).stdout
        return path, text
    return spec, Path(spec).read_text()


def strip_comments(text: str) -> str:
    """Remove C comments, keeping line structure and string literals."""
    out, i, n = [], 0, len(text)
    while i < n:
        c = text[i]
        if c == '"':
            j = i + 1
            while j < n and text[j] != '"':
                j += 2 if text[j] == "\\" else 1
            out.append(text[i:j + 1]); i = j + 1
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2); j = n if j < 0 else j + 2
            out.append("\n" * text.count("\n", i, j)); i = j
        elif text.startswith("//", i):
            j = text.find("\n", i); j = n if j < 0 else j
            i = j
        else:
            out.append(c); i += 1
    return "".join(out)


def matching(text: str, start: int, open_c: str = "{", close_c: str = "}") -> int:
    """Index just past the bracket matching text[start] (which is open_c)."""
    depth, i = 0, start
    while i < len(text):
        if text[i] == open_c:
            depth += 1
        elif text[i] == close_c:
            depth -= 1
            if depth == 0:
                return i + 1
        elif text[i] == '"':
            i += 1
            while i < len(text) and text[i] != '"':
                i += 2 if text[i] == "\\" else 1
        i += 1
    return len(text)


