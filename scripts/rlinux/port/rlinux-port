def rust_const(name: str, value: str, defines: dict[str, str], as_offset: bool) -> str | None:
    v = value.strip()
    while v.startswith("(") and v.endswith(")") and matching(v, 0, "(", ")") == len(v):
        v = v[1:-1].strip()
    v = re.sub(r"\bBIT\((\d+)\)", r"(1 << \1)", v)
    m = re.fullmatch(r"GENMASK\((\d+),\s*(\d+)\)", v)
    if m:
        h, l = int(m.group(1)), int(m.group(2))
        v = hex(((1 << (h - l + 1)) - 1) << l)
    v = re.sub(r"(0[xX][0-9a-fA-F]+|\d+)[uUlL]+\b", r"\1", v)
    if not re.fullmatch(r"[\w\s\(\)\+\-\*/<>|&~^]+", v):
        return None
    ty = "usize" if as_offset else "u32"
    v = v.replace("~", "!")
    return f"const {name}: {ty} = {v};"


def offsets_used(code: str) -> set[str]:
    names = set()
    for m in re.finditer(r"\b(?:readl|writel|readl_relaxed|writel_relaxed|ioread32|iowrite32|readw|writew|readb|writeb)"
                         r"(?:_relaxed)?\s*\(([^;]*)\)", code):
        names.update(re.findall(r"\+\s*([A-Z_][A-Z0-9_]*)", m.group(1)))
    return names


def c_body_comment(text: str, indent: str) -> str:
    return "\n".join(f"{indent}// C: {line}" if line.strip() else f"{indent}//" for line in text.strip().splitlines())


def scaffold_platform_hwrng(d: Driver, k: dict) -> str:
    offs = offsets_used(d.code)
    consts = []
    for n, v in d.defines.items():
        c = rust_const(n, v, d.defines, n in offs)
        consts.append(c if c else f"// TODO(port): translate `#define {n} {v}`")
    has_clk = any(a in d.apis for a in ("devm_clk_get_enabled", "devm_clk_get_optional_enabled", "devm_clk_get"))
    optional_clk = "devm_clk_get_optional_enabled" in d.apis
    ops = {f: d.hwrng.get(f) for f in ("read", "init", "cleanup")}
    s = d.of_ids
    idinfo = "()" if all(x is None for _, x in s) else "usize"
    uses = ["device::Core", "hwrng::{HwRngName, HwRngOptions, HwRngRegistration, Operations}",
            "io::{mem::IoMem, Io}", "of, platform", "prelude::*"]
    if has_clk:
        uses.insert(0, "clk::OptionalClk" if optional_clk else "clk::Clk")
    if any(a in d.apis for a in ("usleep_range", "msleep", "udelay", "fsleep", "mdelay", "ndelay")):
        uses.append("time::{delay, Delta}")
    if any("poll" in a for a in d.apis):
        uses.append("io::poll")
    L = []
    L.append(f"// SPDX-License-Identifier: {d.spdx}")
    for c in d.copyright:
        L.append(f"// {c}")
    L.append("")
    L.append(f"//! Rust port of `{Path(d.path).name}`: {d.description or 'TODO(port): one-line description'}.")
    L.append("//!")
    L.append("//! Generated by scripts/rlinux/port/rlinux-port; resolve every port TODO marker.")
    L.append("")
    L.append("#![allow(dead_code, unused_imports)] // TODO(port): remove once translated")
    L.append("")
    L.append("use kernel::{")
    for u in uses:
        L.append(f"    {u},")
    L.append("};")
    L.append("")
    L += consts
    L.append("")
    L.append("/// The driver data handed to the hwrng core.")
    L.append("struct Rng<'a> {")
    L.append("    mmio: IoMem<'a>,")
    L.append("    // TODO(port): other per-device state from the C driver's private struct")
    L.append("}")
    L.append("")
    L.append("#[vtable]")
    L.append("impl<'a> Operations for Rng<'a> {")
    L.append("    type Ptr = KBox<Self>;")
    for fn, sig, ret in (("init", "fn init(data: &Self) -> Result", "Err(ENOSYS)"),
                         ("cleanup", "fn cleanup(data: &Self)", ""),
                         ("read", "fn read(data: &Self, buffer: &mut [u8], wait: bool) -> Result<usize>", "Err(ENOSYS)")):
        cname = ops.get(fn)
        if not cname and fn != "read":
            continue
        L.append("")
        L.append(f"    {sig} {{")
        body = d.functions.get(cname or "", "")
        if body:
            L.append(c_body_comment(body, "        "))
        L.append(f"        // TODO(port): translate `{cname or 'read'}` above"
                 + (" (return bytes written; never more than buffer.len())" if fn == "read" else ""))
        if fn == "read":
            L.append("        let _ = (data, buffer, wait);")
        else:
            L.append("        let _ = data;")
        if ret:
            L.append(f"        {ret}")
        L.append("    }")
    L.append("}")
    L.append("")
    if has_clk:
        cty = "OptionalClk" if optional_clk else "Clk"
        L.append("/// A prepared and enabled clock, disabled and unprepared on drop.")
        L.append("/// Construct it only AFTER `prepare_enable()` succeeded.")
        L.append(f"struct ClkOn({cty});")
        L.append("")
        L.append("impl Drop for ClkOn {")
        L.append("    fn drop(&mut self) {")
        L.append("        self.0.disable_unprepare();")
        L.append("    }")
        L.append("}")
        L.append("")
    L.append("/// The platform driver's data; fields drop in order: the hwrng is")
    L.append("/// unregistered before anything it uses goes away.")
    L.append("struct Data<'a> {")
    L.append("    _rng: Pin<KBox<HwRngRegistration<Rng<'a>>>>,")
    if has_clk:
        L.append("    _clk: ClkOn,")
    L.append("}")
    L.append("")
    L.append("struct Driver;")
    L.append("")
    L.append("kernel::of_device_table!(")
    L.append("    OF_TABLE,")
    L.append("    <Driver as platform::Driver>::IdInfo,")
    L.append("    [")
    for i, (comp, data) in enumerate(s):
        info = "()" if idinfo == "()" else f"{i}"
        note = f" // TODO(port): C .data = {data}" if data else ""
        L.append(f"        (of::DeviceId::new(c\"{comp}\"), {info}),{note}")
    L.append("    ]")
    L.append(");")
    L.append("")
    L.append("impl platform::Driver for Driver {")
    L.append(f"    type IdInfo = {idinfo};")
    L.append("    type Data<'bound> = Data<'bound>;")
    L.append("    const OF_ID_TABLE: Option<of::IdTable<Self::IdInfo>> = Some(&OF_TABLE);")
    L.append("")
    L.append("    fn probe<'bound>(")
    L.append("        pdev: &'bound platform::Device<Core<'_>>,")
    L.append("        id_info: Option<&'bound Self::IdInfo>,")
    L.append("    ) -> impl PinInit<Self::Data<'bound>, Error> + 'bound {")
    if d.probe and d.probe in d.functions:
        L.append(c_body_comment(d.functions[d.probe], "        "))
    L.append("        let _ = id_info;")
    L.append("        let dev = pdev.as_ref();")
    L.append("        let mmio = pdev.io_request_by_index(0).ok_or(ENODEV)?.iomap()?;")
    if has_clk:
        cty = "OptionalClk" if optional_clk else "Clk"
        cname = re.search(r'devm_clk_get\w*\(\s*[^,]+,\s*"([^"]+)"', d.code)
        arg = f'Some(c"{cname.group(1)}")' if cname else "None"
        L.append(f"        let clk = {cty}::get(dev, {arg})?;")
        L.append("        clk.prepare_enable()?;")
        L.append("        let clk = ClkOn(clk);")
    L.append("        // TODO(port): remaining probe steps from the C code above (resets, waits, checks)")
    L.append("        let rng = KBox::new(Rng { mmio }, GFP_KERNEL)?;")
    if d.hwrng_name_from_pdev:
        L.append("        let name = HwRngName::Owned(dev.name().to_cstring()?);")
    else:
        L.append(f"        let name = HwRngName::Static(c\"{d.name or d.module}\"); // TODO(port): check C `.name`")
    q = d.hwrng.get("quality", "0")
    L.append(f"        let opts = HwRngOptions {{ name, quality: {q} }};")
    L.append("        let rng = KBox::pin_init(HwRngRegistration::register(opts, rng), GFP_KERNEL)?;")
    L.append("        Ok(Data {")
    L.append("            _rng: rng,")
    if has_clk:
        L.append("            _clk: clk,")
    L.append("        })")
    L.append("    }")
    L.append("}")
    L.append("")
    L.append("kernel::module_platform_driver! {")
    L.append("    type: Driver,")
    L.append(f"    name: \"{d.name or d.module}\",")
    L.append(f"    authors: [{', '.join(repr_str(a) for a in d.authors) or repr_str('TODO(port)')}],")
    L.append(f"    description: {repr_str(d.description or 'TODO(port)')},")
    L.append(f"    license: {repr_str(d.license or 'GPL')},")
    L.append("}")
    return "\n".join(L) + "\n"


def repr_str(s: str) -> str:
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def phy_id_expr(drv: dict, defines: dict[str, str]) -> str:
    pid = drv.get("phy_id", "0")
    mask = drv.get("phy_id_mask", "0xffffffff")
    pidv = defines.get(pid, pid)
    if "PHY_ID_MATCH_EXACT" in pid:
        return f"DeviceId::new_with_exact_mask({re.search(r'\((.*)\)', pid).group(1)})"
    if "PHY_ID_MATCH_MODEL" in pid:
        return f"DeviceId::new_with_model_mask({re.search(r'\((.*)\)', pid).group(1)})"
    if "PHY_ID_MATCH_VENDOR" in pid:
        return f"DeviceId::new_with_vendor_mask({re.search(r'\((.*)\)', pid).group(1)})"
    return f"DeviceId::new_with_custom_mask({pidv}, {defines.get(mask, mask)})"


def scaffold_phy(d: Driver, k: dict) -> str:
    L = [f"// SPDX-License-Identifier: {d.spdx}"] + [f"// {c}" for c in d.copyright] + [""]
    L.append(f"//! Rust port of `{Path(d.path).name}`: {d.description or 'TODO(port)'}.")
    L.append("//!")
    L.append("//! Generated by scripts/rlinux/port/rlinux-port; resolve every port TODO marker.")
    L.append("")
    L.append("#![allow(dead_code, unused_imports)] // TODO(port): remove once translated")
    L.append("")
    L.append("use kernel::{")
    L.append("    net::phy::{self, reg::C22, DeviceId, Driver},")
    L.append("    prelude::*,")
    L.append("};")
    L.append("")
    structs = []
    for i, drv in enumerate(d.phy_drivers):
        nm = re.sub(r"\W", "", drv.get("name", f"Phy{i}").strip('"').title())
        structs.append(f"Phy{nm}" if not nm.startswith("Phy") else nm)
    L.append("kernel::module_phy_driver! {")
    L.append(f"    drivers: [{', '.join(structs)}],")
    L.append("    device_table: [")
    for st in structs:
        L.append(f"        DeviceId::new_with_driver::<{st}>(),")
    L.append("    ],")
    L.append(f"    name: \"{d.module}\",")
    L.append(f"    authors: [{', '.join(repr_str(a) for a in d.authors) or repr_str('TODO(port)')}],")
    L.append(f"    description: {repr_str(d.description or 'TODO(port)')},")
    L.append(f"    license: {repr_str(d.license or 'GPL')},")
    L.append("}")
    L.append("")
    for n, v in d.defines.items():
        if n.startswith("PHY_ID_"):
            L.append(f"const {n}: u32 = {v};")
        else:
            c = rust_const(n, v, d.defines, False)
            L.append(c.replace(": u32 =", ": u16 =") if c else f"// TODO(port): translate `#define {n} {v}`")
    for st, drv in zip(structs, d.phy_drivers):
        L.append("")
        L.append(f"struct {st};")
        L.append("")
        L.append("#[vtable]")
        L.append(f"impl Driver for {st} {{")
        L.append(f"    const NAME: &'static CStr = c{drv.get('name', '\"TODO\"')};")
        L.append(f"    const PHY_DEVICE_ID: DeviceId = {phy_id_expr(drv, d.defines)};")
        if "features" in drv and drv["features"] in PHY_FEATURES:
            L.append("")
            L.append("    fn get_features(dev: &mut phy::Device) -> Result {")
            L.append(f"        // C: .features = {drv['features']}")
            L.append(f"        dev.set_supported(phy::Features::{PHY_FEATURES[drv['features']]});")
            L.append("        Ok(())")
            L.append("    }")
        sigs = {"probe": "fn probe(dev: &mut phy::Device) -> Result",
                "read_status": "fn read_status(dev: &mut phy::Device) -> Result<u16>",
                "config_aneg": "fn config_aneg(dev: &mut phy::Device) -> Result",
                "soft_reset": "fn soft_reset(dev: &mut phy::Device) -> Result",
                "suspend": "fn suspend(dev: &mut phy::Device) -> Result",
                "resume": "fn resume(dev: &mut phy::Device) -> Result",
                "config_init": "fn config_init(dev: &mut phy::Device) -> Result",
                "link_change_notify": "fn link_change_notify(dev: &mut phy::Device)"}
        for cb, sig in sigs.items():
            if cb not in drv:
                continue
            cfn = drv[cb]
            L.append("")
            L.append(f"    {sig} {{")
            if cfn in d.functions:
                L.append(c_body_comment(d.functions[cfn], "        "))
            elif cfn.startswith("genphy_") or cfn.startswith("gen10g_"):
                L.append(f"        // C uses the generic helper `{cfn}`; call the Rust equivalent or mirror it")
            L.append(f"        // TODO(port): translate `{cfn}`")
            L.append("        let _ = dev;")
            if "->" in sig:
                L.append("        Err(ENOSYS)")
            L.append("    }")
        L.append("}")
    return "\n".join(L) + "\n"


def kconfig_edit(k: dict, bus: str, uses_clk: bool) -> str | None:
    if not k["kconfig"] or not k["kblock"]:
        return None
    path = TREE / k["kconfig"]
    text = path.read_text()
    block = k["kblock"]
    dep = "RUST_PHYLIB_ABSTRACTIONS" if bus == "phy" else "RUST"
    if re.search(rf"depends on .*\b{dep}\b", block):
        return None
    lines = block.splitlines(keepends=True)
    idx = max([i for i, l in enumerate(lines) if l.strip().startswith(("depends on", "tristate", "bool"))], default=1)
    lines.insert(idx + 1, f"\tdepends on {dep}\n")
    path.write_text(text.replace(block, "".join(lines), 1))
    return f"{k['kconfig']}: + depends on {dep}"


def cmd_scaffold(args) -> int:
    d = parse(args.file)
    k = kconfig_facts(d)
    ok, gaps, cautions = coverage(d)
    if gaps and not args.force:
        print("refusing: abstraction gaps (re-run with --force to scaffold anyway):", file=sys.stderr)
        for g in gaps:
            print(f"  - {g}", file=sys.stderr)
        return 1
    if d.bus == "platform" and re.search(r"struct\s+hwrng", d.code):
        rs = scaffold_platform_hwrng(d, k)
    elif d.bus == "phy":
        rs = scaffold_phy(d, k)
    else:
        print(f"no scaffold template for bus '{d.bus}' (analyze still works)", file=sys.stderr)
        return 1
    out = Path(d.path).with_suffix(".rs")
    if out.exists() and not args.overwrite:
        print(f"{out} exists (use --overwrite)", file=sys.stderr)
        return 1
    out.write_text(rs)
    print(f"wrote {out} ({rs.count(chr(10))} lines, {rs.count('TODO(port)')} TODO(port) markers)")
    uses_clk = any("clk" in a for a in d.apis)
    edit = kconfig_edit(k, d.bus, uses_clk)
    if edit:
        print(f"edited {edit}")
    if k["symbol"]:
        frag = Path("ci/config.d") / f"{k['symbol'].lower().replace('_', '-')}.config"
        lines = []
        deps = " ".join(k["depends"])
        if "COMPILE_TEST" in deps:
            lines.append("CONFIG_COMPILE_TEST=y")
        if re.search(r"\bOF\b", deps):
            lines.append("CONFIG_OF=y")
        if uses_clk:
            lines.append("CONFIG_COMMON_CLK=y")
        if d.bus == "phy":
            lines += ["CONFIG_PHYLIB=y", "CONFIG_RUST_PHYLIB_ABSTRACTIONS=y"]
        lines.append(f"CONFIG_{k['symbol']}=m")
        if Path("ci/config.d").is_dir():
            frag.write_text("\n".join(lines) + "\n")
            Path("ci/modules.d", frag.stem + ".txt").write_text(d.module + "\n")
            print(f"wrote {frag} and ci/modules.d/{frag.stem}.txt")
    if not args.keep_c and Path(d.path).exists():
        if subprocess.run(["git", "rm", "-q", "-f", d.path], check=False).returncode != 0:
            Path(d.path).unlink(missing_ok=True)
        print(f"git rm {d.path}  (kbuild would otherwise keep building the C file; "
              f"read it with `git show HEAD:{d.path}`)")
    if cautions:
        print("cautions:")
        for c in cautions:
            print(f"  ! {c}")
    print("next: translate every TODO(port), build with `LLVM=-21 ci/build.sh`, run "
          f"`scripts/rlinux/port/rlinux-port compare HEAD:{d.path} {out}`")
    return 0


