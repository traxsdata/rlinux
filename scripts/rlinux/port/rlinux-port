round_up round_down __maybe_unused __aligned __iomem __init __exit __devinit
""".split())


def unknown_calls(d: "Driver") -> list[str]:
    """External calls neither modelled in RULES/API_CALLS nor benign nor defined in the file."""
    known = set(API_CALLS) | {r.api for r in RULES} | BENIGN_CALLS | set(d.functions)
    code = re.sub(r'"(?:\\.|[^"\\])*"', '""', d.code)   # ignore words inside strings
    calls = set(re.findall(r"\b([A-Za-z_]\w{2,})\s*\(", code))
    macros = set(re.findall(r"#define\s+(\w+)\(", d.code))
    return sorted(c for c in calls - known - macros
                  if not c.isupper() and not c.startswith(("__builtin", "rust_")))


def tree_has(pattern: str, *paths: str) -> bool:
    for p in paths:
        for f in sorted(TREE.glob(p)):
            if f.is_file() and re.search(pattern, f.read_text(errors="replace")):
                return True
    return False


