C_KEYWORDS = {"if", "for", "while", "switch", "return", "else", "do", "sizeof"}


def parse(spec: str) -> Driver:
    path, raw = read_source(spec)
    code = strip_comments(raw)
    d = Driver(path=path, raw=raw, code=code)
    d.rev = spec.split(":", 1)[0] if (":" in spec and not os.path.exists(spec)) else None
    d.module = Path(path).stem

    m = re.search(r"SPDX-License-Identifier:\s*([^\s*]+(?:\s+(?:OR|AND)\s+[^\s*]+)*)", raw)
    if m:
        d.spdx = m.group(1).strip()
    d.copyright = [l.strip(" */\t") for l in raw.splitlines()[:30]
                   if re.search(r"Copyright|\(C\)|\(c\)", l)]
    d.authors = re.findall(r'MODULE_AUTHOR\("([^"]*)"\)', code)
    m = re.search(r'MODULE_DESCRIPTION\("([^"]*)"\)', code)
    d.description = m.group(1) if m else ""
    m = re.search(r'MODULE_LICENSE\("([^"]*)"\)', code)
    d.license = m.group(1) if m else ""

    for m in re.finditer(r"^[ \t]*#define[ \t]+([A-Za-z_]\w*)[ \t]+(.+?)[ \t]*$", code, re.M):
        if "(" not in m.group(1):
            d.defines[m.group(1)] = m.group(2).rstrip("\\").strip()

    for m in re.finditer(r"^(?=[A-Za-z_])(?:static\s+)?(?:inline\s+)?[\w \t\*]+?\b(\w+)\s*\([^;{)]*\)\s*\{",
                         code, re.M):
        if m.group(1) in C_KEYWORDS:
            continue
        start = code.index("{", m.end() - 1)
        d.functions[m.group(1)] = code[m.start():matching(code, start)]

    for m in re.finditer(r"struct\s+of_device_id\s+(?:__maybe_unused\s+)?\w+\s*\[\]\s*(?:__maybe_unused\s*)?=\s*\{",
                         code):
        body = code[m.end() - 1:matching(code, m.end() - 1)]
        for e in re.finditer(r'\.compatible\s*=\s*"([^"]+)"(?:[^}]*?\.data\s*=\s*([^,}]+))?', body):
            d.of_ids.append((e.group(1), e.group(2).strip() if e.group(2) else None))
    for m in re.finditer(r"struct\s+acpi_device_id\s+(?:__maybe_unused\s+)?\w+\s*\[\]\s*(?:__maybe_unused\s*)?=\s*\{",
                         code):
        body = code[m.end() - 1:matching(code, m.end() - 1)]
        d.acpi_ids += re.findall(r'"([A-Z0-9]{4,8})"', body)

    # Bus / driver struct.
    for bus, pat in (("platform", r"struct\s+platform_driver\s+\w+\s*=\s*\{"),
                     ("pci", r"struct\s+pci_driver\s+\w+\s*=\s*\{"),
                     ("i2c", r"struct\s+i2c_driver\s+\w+\s*=\s*\{"),
                     ("phy", r"struct\s+phy_driver\s+\w+\s*\[\w*\]\s*=\s*\{")):
        m = re.search(pat, code)
        if not m:
            continue
        d.bus = bus
        body = code[m.end() - 1:matching(code, m.end() - 1)]
        if bus == "phy":
            inner = body[1:]
            for e in re.finditer(r"\{", inner):
                pass
            i = 0
            while True:
                j = inner.find("{", i)
                if j < 0:
                    break
                entry = inner[j:matching(inner, j)]
                i = j + len(entry)
                fields = dict(re.findall(r"\.(\w+)\s*=\s*([^,]+?)\s*,?\s*(?=\n|\.|\}$)", entry))
                if fields:
                    d.phy_drivers.append({k: v.strip().rstrip(",") for k, v in fields.items()})
        else:
            m2 = re.search(r'\.name\s*=\s*"([^"]+)"', body)
            d.name = m2.group(1) if m2 else None
            m2 = re.search(r"\.probe\s*=\s*(\w+)", body)
            d.probe = m2.group(1) if m2 else None
            m2 = re.search(r"\.remove(?:_new)?\s*=\s*(\w+)", body)
            d.remove = m2.group(1) if m2 else None
        break

    # hwrng ops, both designated-initialiser and assignment styles.
    for fld in ("name", "read", "init", "cleanup", "quality", "data_read", "data_present", "priv"):
        m = re.search(rf"(?:\.|->|\brng\.)(?:rng\.|ops\.)?{fld}\s*=\s*([^;,\n]+)", code)
        if m and re.search(r"struct\s+hwrng", code):
            d.hwrng[fld] = m.group(1).strip()
    d.hwrng_name_from_pdev = bool(re.search(r"name\s*=\s*(?:pdev|dev)->name|name\s*=\s*dev_name\(", code))

    for api in API_CALLS:
        if re.search(rf"\b{re.escape(api)}\s*\(", code) or (api == "platform_data" and "platform_data" in code):
            d.apis.add(api)
    return d


