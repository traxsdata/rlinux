def cmd_api_index(args) -> int:
    root = TREE / "rust/kernel"
    out = []
    for f in sorted(root.rglob("*.rs")):
        rel = f.relative_to(TREE)
        cfg = None
        impl = None
        for no, line in enumerate(f.read_text(errors="replace").splitlines(), 1):
            s = line.strip()
            m = re.match(r"#\[cfg\((.+)\)\]", s)
            if m:
                cfg = m.group(1)
                continue
            m = re.match(r"(?:pub(?:\([^)]*\))?\s+)?impl\b(.*?)\{?$", s)
            if s.startswith(("impl", "pub impl")) or (m and s.startswith("impl")):
                impl = re.sub(r"\s*\{$", "", s)
            if re.match(r"pub (?:const )?(?:unsafe )?(?:fn|struct|enum|trait|type|mod|const|static|macro)\b", s) \
                    or s.startswith("macro_rules!"):
                sig = re.sub(r"\s*\{.*$", "", s).rstrip(";")
                ctx = f"  [{impl}]" if impl and sig.startswith(("pub fn", "pub const fn", "pub unsafe fn")) else ""
                gate = f"  #[cfg({cfg})]" if cfg else ""
                out.append(f"{rel}:{no}: {sig}{ctx}{gate}")
            if s and not s.startswith("#"):
                cfg = None
    text = "# rust/kernel public API index (generated by rlinux-port api-index)\n" + "\n".join(out) + "\n"
    if args.out:
        Path(args.out).write_text(text)
        print(f"wrote {args.out} ({len(out)} entries)")
    else:
        sys.stdout.write(text)
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("analyze"); a.add_argument("file"); a.set_defaults(fn=cmd_analyze)
    s = sub.add_parser("scaffold"); s.add_argument("file")
    s.add_argument("--keep-c", action="store_true", help="don't git rm the C file")
    s.add_argument("--force", action="store_true", help="scaffold despite abstraction gaps")
    s.add_argument("--overwrite", action="store_true"); s.set_defaults(fn=cmd_scaffold)
    c = sub.add_parser("compare"); c.add_argument("c"); c.add_argument("rust"); c.set_defaults(fn=cmd_compare)
    i = sub.add_parser("api-index"); i.add_argument("--out"); i.set_defaults(fn=cmd_api_index)
    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
