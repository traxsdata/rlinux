    Rule("timer_setup", "", (r"timer_list|struct Timer\b", "rust/kernel/**/*.rs"),
         missing_hint="no timer_list abstraction (consider hrtimer)"),
]

HWRNG_FIELDS = {"read": "required `read`", "init": "#[optional] `init`", "cleanup": "#[optional] `cleanup`",
                "quality": "`HwRngOptions::quality`", "name": "`HwRngOptions::name` (HwRngName)",
                "data_read": None, "data_present": None, "priv": "driver data (`T::Ptr`)"}

PHY_CALLBACKS = {
    "probe": "probe", "read_status": "read_status", "config_aneg": "config_aneg",
    "soft_reset": "soft_reset", "suspend": "suspend", "resume": "resume",
    "get_features": "get_features", "match_phy_device": "match_phy_device",
    "read_mmd": "read_mmd", "write_mmd": "write_mmd", "link_change_notify": "link_change_notify",
    "config_init": "config_init", "aneg_done": "aneg_done", "config_intr": "config_intr",
    "handle_interrupt": "handle_interrupt", "read_page": "read_page", "write_page": "write_page",
    "get_sset_count": "get_sset_count", "get_strings": "get_strings", "get_stats": "get_stats",
}
PHY_FEATURES = {"PHY_BASIC_FEATURES": "Basic", "PHY_GBIT_FEATURES": "Gbit", "PHY_10GBIT_FEATURES": "TenGbit"}


def phy_trait_supports(cb: str) -> bool:
    return tree_has(rf"\bfn {cb}\s*\(", "rust/kernel/net/phy.rs")


def coverage(d: Driver) -> tuple[list[str], list[str], list[str]]:
    ok, gaps, cautions = [], [], []
    for r in RULES:
        if r.api not in d.apis:
            continue
        supported = True if r.present is None else tree_has(r.present[0], r.present[1])
        if supported:
            ok.append(f"{r.api} -> {r.ok_hint}")
            if r.caution:
                cautions.append(f"{r.api}: {r.caution}")
        else:
            gaps.append(f"{r.api}: {r.missing_hint or 'no Rust equivalent found'}")
    if d.bus == "phy":
        for drv in d.phy_drivers:
            for k in drv:
                if k in PHY_CALLBACKS and k not in ("get_features",) and not phy_trait_supports(PHY_CALLBACKS[k]):
                    gaps.append(f"phy_driver.{k}: phy::Driver has no `{k}` callback (needs abstraction)")
            if "features" in drv:
                feat = drv["features"]
                if feat in PHY_FEATURES and tree_has(r"pub enum Features", "rust/kernel/net/phy.rs"):
                    ok.append(f"features={feat} -> get_features: dev.set_supported(phy::Features::{PHY_FEATURES[feat]})")
                else:
                    gaps.append(f"phy_driver.features={feat}: no matching phy::Features variant")
    if d.bus == "platform" and re.search(r"struct\s+hwrng", d.code):
        for fld in d.hwrng:
            if HWRNG_FIELDS.get(fld, "") is None:
                gaps.append(f"hwrng.{fld}: legacy API, not in hwrng::Operations (convert to `read`)")
        if not tree_has(r"pub struct HwRngRegistration", "rust/kernel/hwrng.rs"):
            gaps.append("hwrng: no kernel::hwrng abstraction in this tree")
    if d.bus in ("pci", "i2c", "unknown"):
        cautions.append(f"bus '{d.bus}': no scaffold template yet (analyze only)")
    if re.search(r"\.dev_groups\s*=|ATTRIBUTE_GROUPS\(", d.code):
        if tree_has(r"dev_groups", "rust/kernel/**/*.rs"):
            ok.append("dev_groups -> driver attribute groups")
        else:
            gaps.append("dev_groups/ATTRIBUTE_GROUPS: Rust drivers can't declare sysfs groups yet (rlinux #9)")
    return ok, gaps, cautions


